# Shir Capital Partners Trading Bot - Environment Variables
# Copy this file to .env and customize for your local development
# Environment variables override values in config/core.yaml

# System Configuration
# SCP_SYSTEM__DATA_PATH=./data/
# SCP_SYSTEM__LOG_PATH=./logs/
# SCP_SYSTEM__DB_PATH=sqlite:///db/core.db
# SCP_SYSTEM__TIMEZONE=UTC
# SCP_SYSTEM__TIMEFRAMES=["1m", "5m", "15m"]

# Assets Configuration
# SCP_ASSETS__SYMBOLS=["GC", "DXY"]
# SCP_ASSETS__BROKER=SIMULATION
# SCP_ASSETS__START_DATE=2022-01-01
# SCP_ASSETS__END_DATE=2025-12-31

# Risk Configuration
# SCP_RISK__STARTUP_RISK_PER_TRADE=350
# SCP_RISK__GROWTH_RISK_PER_TRADE=600
# SCP_RISK__DAILY_DRAWDOWN_LIMIT=600
# SCP_RISK__RR_TARGET=3.0

# Backtest Configuration
# SCP_BACKTEST__INITIAL_BALANCE=100000
# SCP_BACKTEST__COMMISSION_PER_TRADE=5
# SCP_BACKTEST__SLIPPAGE_POINTS=0.5
# SCP_BACKTEST__MOCK_STRATEGY=true

# =============================================================================
# IB Gateway Configuration (Docker)
# =============================================================================
# IB_USERNAME=your_ib_username
# IB_PASSWORD=your_ib_password
# IB_TRADING_MODE=paper
# IB_PORT=4004
# VNC_PASSWORD=your_vnc_password
# TIME_ZONE=America/New_York

# Notes:
# - Use double underscores (__) to represent nested configuration keys
# - Boolean values: true/false, 1/0, yes/no, on/off
# - Lists: Use JSON array format, e.g., ["1m", "5m", "15m"]
# - Numbers: Automatically parsed as int or float

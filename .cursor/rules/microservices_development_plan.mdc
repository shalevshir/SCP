import pytest
from datetime import datetime, timezone
from data_adapter.candle_aggregator import CandleAggregator
from scp_shared.messaging.schemas import CandleMessage


class TestCandleAggregator:
    """Test tick → candle aggregation."""
    
    def test_first_tick_initializes_candle(self):
        """First tick in minute starts new candle."""
        agg = CandleAggregator(symbol="GC", timeframe="1m")
        
        tick = Tick(
            timestamp=datetime(2025, 1, 15, 10, 0, 5, tzinfo=timezone.utc),
            price=2650.0,
            volume=10,
        )
        
        result = agg.update(tick)
        
        assert result is None  # Candle not closed yet
        assert agg.current_candle is not None
        assert agg.current_candle.open == 2650.0
    
    def test_minute_boundary_closes_candle(self):
        """Tick at new minute closes previous candle."""
        agg = CandleAggregator(symbol="GC", timeframe="1m")
        
        # Tick at 10:00:05
        agg.update(Tick(
            timestamp=datetime(2025, 1, 15, 10, 0, 5, tzinfo=timezone.utc),
            price=2650.0, volume=10,
        ))
        
        # Tick at 10:00:30 (high)
        agg.update(Tick(
            timestamp=datetime(2025, 1, 15, 10, 0, 30, tzinfo=timezone.utc),
            price=2655.0, volume=20,
        ))
        
        # Tick at 10:00:45 (low)
        agg.update(Tick(
            timestamp=datetime(2025, 1, 15, 10, 0, 45, tzinfo=timezone.utc),
            price=2648.0, volume=15,
        ))
        
        # Tick at 10:01:00 (closes 10:00 candle)
        result = agg.update(Tick(
            timestamp=datetime(2025, 1, 15, 10, 1, 0, tzinfo=timezone.utc),
            price=2652.0, volume=25,
        ))
        
        assert result is not None
        assert result.timestamp == datetime(2025, 1, 15, 10, 0, tzinfo=timezone.utc)
        assert result.open == 2650.0
        assert result.high == 2655.0
        assert result.low == 2648.0
        assert result.close == 2648.0  # Last tick before boundary
        assert result.volume == 45  # Sum of volumes
    
    def test_no_tick_gap_detection(self):
        """Detect missing candles when gap > 1 minute."""
        agg = CandleAggregator(symbol="GC", timeframe="1m")
        
        agg.update(Tick(
            timestamp=datetime(2025, 1, 15, 10, 0, 30, tzinfo=timezone.utc),
            price=2650.0, volume=10,
        ))
        
        # 5-minute gap
        result = agg.update(Tick(
            timestamp=datetime(2025, 1, 15, 10, 5, 30, tzinfo=timezone.utc),
            price=2655.0, volume=20,
        ))
        
        assert agg.gap_detected
        assert agg.gap_start == datetime(2025, 1, 15, 10, 1, tzinfo=timezone.utc)
        assert agg.gap_end == datetime(2025, 1, 15, 10, 5, tzinfo=timezone.utc)

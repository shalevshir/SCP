## Appendix A: Makefile Commands

```makefile
# Makefile

.PHONY: infra-up infra-down test test-integration build-all deploy

# Infrastructure
infra-up:
	docker-compose -f infra/docker-compose.yml up -d redis postgres

infra-down:
	docker-compose -f infra/docker-compose.yml down

# Testing
test:
	@for svc in data-adapter feature-engine htf-bias bot-core execution; do \
		echo "Testing $$svc..."; \
		cd services/$$svc && poetry run pytest tests/ -v && cd ../..; \
	done

test-integration:
	docker-compose -f infra/docker-compose.test.yml up -d
	poetry run pytest tests/integration/ -v
	docker-compose -f infra/docker-compose.test.yml down

# Build
build-all:
	docker-compose build

# Deploy
deploy-paper:
	docker-compose -f docker-compose.yml -f docker-compose.paper.yml up -d

deploy-live:
	docker-compose -f docker-compose.yml -f docker-compose.live.yml up -d

# Replay
replay:
	docker-compose -f docker-compose.yml -f docker-compose.replay.yml up -d
	poetry run python scripts/replay_historical.py --start $(START) --end $(END)

# Monitoring
logs:
	docker-compose logs -f

logs-service:
	docker-compose logs -f $(SERVICE)

# Database
migrate:
	psql -h localhost -U scp -d scp -f infra/migrations/001_initial_schema.sql

seed-test-data:
	bash infra/scripts/seed-test-data.sh
```


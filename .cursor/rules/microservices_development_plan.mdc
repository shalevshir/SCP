### 2.3 Implementation Skeleton

```python
# services/data-adapter/src/data_adapter/main.py

import asyncio
import signal
from contextlib import asynccontextmanager

import redis.asyncio as redis
from fastapi import FastAPI

from data_adapter.config import Settings
from data_adapter.databento_client import DatabentoClient
from data_adapter.candle_aggregator import CandleAggregator
from data_adapter.gap_detector import GapDetector
from data_adapter.publisher import CandlePublisher
from scp_shared.health import health_router


settings = Settings()
shutdown_event = asyncio.Event()


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Manage application lifecycle."""
    # Startup
    redis_client = redis.Redis.from_url(settings.redis_url)
    publisher = CandlePublisher(redis_client)
    
    gc_aggregator = CandleAggregator(symbol="GC", timeframe="1m")
    dxy_aggregator = CandleAggregator(symbol="DXY", timeframe="1m")
    gap_detector = GapDetector(backfill_client=DatabentoClient(settings.databento_api_key))
    
    # Start WebSocket consumer
    task = asyncio.create_task(
        consume_ticks(
            settings.databento_ws_url,
            gc_aggregator,
            dxy_aggregator,
            gap_detector,
            publisher,
        )
    )
    
    yield
    
    # Shutdown
    shutdown_event.set()
    task.cancel()
    await redis_client.close()


app = FastAPI(lifespan=lifespan)
app.include_router(health_router)


async def consume_ticks(
    ws_url: str,
    gc_agg: CandleAggregator,
    dxy_agg: CandleAggregator,
    gap_detector: GapDetector,
    publisher: CandlePublisher,
) -> None:
    """Main loop: consume ticks, aggregate, publish."""
    async with DatabentoClient(ws_url) as client:
        async for tick in client.stream_ticks():
            if shutdown_event.is_set():
                break
            
            # Route to correct aggregator
            aggregator = gc_agg if tick.symbol == "GC" else dxy_agg
            
            # Check for gaps
            if gap_detector.detect_gap(tick.timestamp, tick.symbol):
                await gap_detector.backfill(publisher)
            
            # Aggregate
            candle = aggregator.update(tick)
            
            if candle is not None:
                # Session filter
                if is_trading_hours(candle.timestamp):
                    await publisher.publish(candle)


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8001)
```


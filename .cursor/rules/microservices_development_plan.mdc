### 8.3 Replay Mode Implementation

```python
# services/data-adapter/src/data_adapter/replay_mode.py

class ReplayModeDataAdapter:
    """Replay historical candles from database instead of live feed."""
    
    def __init__(
        self,
        db_url: str,
        redis_url: str,
        start: datetime,
        end: datetime,
        speed_multiplier: float = 1.0,
    ):
        self.db = Database(db_url)
        self.redis = redis.Redis.from_url(redis_url)
        self.start = start
        self.end = end
        self.speed_multiplier = speed_multiplier
    
    async def replay(self) -> None:
        """Replay historical candles at specified speed."""
        candles = await self.db.fetch_all(
            "SELECT * FROM candles WHERE timestamp >= $1 AND timestamp < $2 ORDER BY timestamp",
            self.start, self.end,
        )
        
        publisher = RedisStreamPublisher(self.redis)
        
        prev_ts = None
        for candle in candles:
            # Simulate time passage
            if prev_ts is not None:
                delay = (candle.timestamp - prev_ts).total_seconds()
                await asyncio.sleep(delay / self.speed_multiplier)
            
            await publisher.publish(
                f"candles.{candle.timeframe}.{candle.symbol.lower()}",
                CandleMessage.from_db_row(candle),
            )
            
            prev_ts = candle.timestamp
```

### 8.4 Comparison Script

```python
# scripts/compare_results.py

def compare_backtest_vs_microservices(
    backtest_results: list[Trade],
    microservice_results: list[Trade],
) -> ComparisonReport:
    """Compare trade-by-trade results."""
    report = ComparisonReport()
    
    # Match trades by timestamp
    bt_by_ts = {t.opened_at: t for t in backtest_results}
    ms_by_ts = {t.opened_at: t for t in microservice_results}
    
    all_timestamps = set(bt_by_ts.keys()) | set(ms_by_ts.keys())
    
    for ts in sorted(all_timestamps):
        bt_trade = bt_by_ts.get(ts)
        ms_trade = ms_by_ts.get(ts)
        
        if bt_trade and not ms_trade:
            report.add_missing_in_microservices(bt_trade)
        elif ms_trade and not bt_trade:
            report.add_extra_in_microservices(ms_trade)
        else:
            # Compare details
            if not trades_match(bt_trade, ms_trade):
                report.add_mismatch(bt_trade, ms_trade)
            else:
                report.add_match(bt_trade)
    
    return report


def trades_match(bt: Trade, ms: Trade) -> bool:
    """Check if two trades match within tolerance."""
    return (
        bt.direction == ms.direction
        and bt.setup_type == ms.setup_type
        and abs(bt.entry_price - ms.entry_price) < 0.01
        and abs(bt.sl_price - ms.sl_price) < 0.01
        and abs(bt.tp_price - ms.tp_price) < 0.01
        and bt.exit_reason == ms.exit_reason
    )
```


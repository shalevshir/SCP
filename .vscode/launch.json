{
  "version": "0.2.0",
  "configurations": [
    // ===== MICROSERVICES DEBUG CONFIGURATIONS =====
    {
      "name": "Data Adapter Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "data_adapter.main:app",
        "--host", "0.0.0.0",
        "--port", "8001",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/services/data-adapter",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/data-adapter/src:${workspaceFolder}/services/shared/src",
        "SERVICE_MODE": "dev",
        "REDIS_URL": "redis://localhost:6379",
        "DATABASE_URL": "postgresql://scp:scp_dev_password@localhost:5432/scp",
        "LOG_LEVEL": "DEBUG",
        // Data provider selection (use "mock" for local dev without IB Gateway, "ib" for live testing)
        "DATA_PROVIDER": "mock",
        // Mock data configuration
        "MOCK_DATA_PATH": "${workspaceFolder}/data",
        // Databento configuration
        "DATABENTO_API_KEY": "",
        "DATABENTO_DATASET": "GLBX.MDP3",
        "DATABENTO_GC_SYMBOL": "GC.FUT",
        "DATABENTO_DXY_SYMBOL": "DX.FUT",
        // IB Gateway configuration (for IB data provider)
        "IB_HOST": "127.0.0.1",
        "IB_PORT": "4002",
        "IB_CLIENT_ID": "10",
        "IB_GC_SYMBOL": "GC",
        "IB_DXY_SYMBOL": "DX",
        // Session filter configuration (disabled for local dev)
        "SESSION_FILTER_ENABLED": "false",
        // Gap detection configuration (disabled for local dev)
        "GAP_BACKFILL_ENABLED": "false",
        // Reconnection configuration
        "RECONNECT_MAX_RETRIES": "10",
        "RECONNECT_BASE_DELAY": "1.0",
        "RECONNECT_MAX_DELAY": "60.0"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "services",
        "order": 1
      },
      "consoleName": "🔌 Data Adapter"
    },
    {
      "name": "Feature Engine Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "feature_engine_svc.main:app",
        "--host", "0.0.0.0",
        "--port", "8002",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/services/feature-engine",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/feature-engine/src:${workspaceFolder}/services/shared/src",
        "SERVICE_MODE": "dev",
        "REDIS_URL": "redis://localhost:6379",
        "DATABASE_URL": "postgresql://scp:scp_dev_password@localhost:5432/scp",
        "ENABLE_WARMUP": "false",
        "LOG_LEVEL": "DEBUG"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "services",
        "order": 2
      },
      "consoleName": "⚙️ Feature Engine"
    },
    {
      "name": "HTF Bias Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "htf_bias_svc.main:app",
        "--host", "0.0.0.0",
        "--port", "8003",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/services/htf-bias",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/htf-bias/src:${workspaceFolder}/services/shared/src",
        "SERVICE_MODE": "dev",
        "REDIS_URL": "redis://localhost:6379",
        "DATABASE_URL": "postgresql://scp:scp_dev_password@localhost:5432/scp",
        "ENABLE_WARMUP": "true",
        "REPLAY_START_TIMESTAMP": "2025-11-06T00:00:00+00:00",
        "LOG_LEVEL": "DEBUG",
        "DEBUG_LOG_PATH": "${workspaceFolder}/.cursor/debug.log"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "services",
        "order": 3
      },
      "consoleName": "📊 HTF Bias"
    },
    {
      "name": "Bot Core Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "bot_core_svc.main:app",
        "--host", "0.0.0.0",
        "--port", "8004",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/services/bot-core",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/bot-core/src:${workspaceFolder}/services/shared/src",
        "SERVICE_MODE": "dev",
        "REDIS_URL": "redis://localhost:6379",
        "DATABASE_URL": "postgresql://scp:scp_dev_password@localhost:5432/scp",
        "SESSION_CONFIG_PATH": "${workspaceFolder}/config/validation.yaml",
        "SESSION_VALIDATION_ENABLED": "false",
        "ENFORCER_TIER": "EarlyMild",
        "LOG_LEVEL": "DEBUG"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "services",
        "order": 4
      },
      "consoleName": "🤖 Bot Core"
    },
    {
      "name": "Execution Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "execution_svc.main:app",
        "--host", "0.0.0.0",
        "--port", "8005",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/services/execution",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/execution/src:${workspaceFolder}/services/shared/src",
        "SERVICE_MODE": "dev",
        "REDIS_URL": "redis://localhost:6379",
        "DATABASE_URL": "postgresql://scp:scp_dev_password@localhost:5432/scp",
        "LOG_LEVEL": "DEBUG",
        // Broker configuration
        "BROKER_MODE": "paper",
        // Interactive Brokers connection settings
        "IB_HOST": "127.0.0.1",
        "IB_PORT": "7497",
        "IB_CLIENT_ID": "1",
        "IB_ACCOUNT": "",
        // Trade limits
        "PDLL_LIMIT": "1000.0",
        "MAX_ACTIVE_TRADES": "3",
        "MAX_TRADES_PER_DAY": "10",
        // Position sizing
        "SIZING_MODE": "fixed",
        "FIXED_QUANTITY": "1",
        "RISK_PER_TRADE_PERCENT": "1.0",
        // Stop loss configuration
        "SL_BUFFER_TICKS": "5",
        // Slippage and commission (disabled for production)
        "ENABLE_SLIPPAGE": "false",
        "SLIPPAGE_POINTS": "0.5",
        "ENABLE_COMMISSION": "false",
        "COMMISSION_PER_TRADE": "5.0"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "services",
        "order": 5
      },
      "consoleName": "💹 Execution"
    },
    {
      "name": "Debug Backtest Viewer (Load Results)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.run_backtest_and_view",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--load",
        "output/backtest_results_20251201_20251209.json",
        "--view",
        "--port",
        "8051"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug Backtest (Full Run + View)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.run_backtest_and_view",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [ 
        "--start",
        "2025-09-08T01:00:00Z",
        "--end",
        "2025-12-07T23:00:00Z",
        "--buffer-phase",
        "growth",
        "--tier-active",
        "EarlyMild",
        "--warmup-days",
        "2",
        "--view"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug Backtest (Run Only, No View)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.run_backtest_and_view",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--start",
        "2025-12-01T10:00:00Z",
        "--end",
        "2025-12-08T13:00:00Z",
        "--buffer-phase",
        "growth",
        "--tier-active",
        "EarlyMild",
        "--no-view"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ],
  "compounds": [
    {
      "name": "All Microservices",
      "configurations": [
        "Data Adapter Service",
        "Feature Engine Service",
        "HTF Bias Service",
        "Bot Core Service",
        "Execution Service"
      ],
      "stopAll": true,
      "presentation": {
        "group": "microservices",
        "order": 1
      }
    },
    {
      "name": "Core Pipeline (Feature → Bot → Execution)",
      "configurations": [
        "Feature Engine Service",
        "Bot Core Service",
        "Execution Service"
      ],
      "stopAll": true,
      "presentation": {
        "group": "microservices",
        "order": 2
      }
    }
  ]
}
